# Copy this file to .env and fill in your key. NEVER commit .env to GitHub.

# Free key: https://console.groq.com
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
# Check https://console.groq.com/docs/models for current model names
LLM_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.2

# Local embedding model (downloaded automatically on first run)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Retrieval settings
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4
SKILL_MATCH_THRESHOLD=0.62
